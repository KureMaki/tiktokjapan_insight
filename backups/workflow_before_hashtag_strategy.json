h":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"Cultural_Keyword","displayName":"Cultural_Keyword","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"content_format","displayName":"content_format","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"distribution_signal","displayName":"distribution_signal","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"Risk_Factor","displayName":"Risk_Factor","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"Business_Insight","displayName":"Business_Insight","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"Methodology","displayName":"Methodology","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"Timestamp","displayName":"Timestamp","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true}],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[192,0],"id":"5debd29b-7044-49ea-841d-e6fc6300c75f","name":"Append or update row in sheet","credentials":{"googleSheetsOAuth2Api":{"id":"hdGavWk1HagzoUFs","name":"Google Sheets account"}}},{"parameters":{"formTitle":"TikTok视频运营分析器","formDescription":"请输入 TikTok 视频 URL，Agent将自动拆解爆点、文化背景及运营价值分析。","formFields":{"values":[{"fieldLabel":"视频链接","requiredField":true}]},"options":{}},"type":"n8n-nodes-base.formTrigger","typeVersion":2.5,"position":[-704,0],"id":"8d886446-3b4a-4810-97d7-44dba587f2bb","name":"On form submission","webhookId":"1bdcb38c-0d61-447a-bb3e-dc0d75e95b3d"},{"parameters":{"operation":"completion","respondWith":"showText","responseText":"=<div style=\"font-family: -apple-system, system-ui, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color: #1f2937; line-height: 1.6; padding: 20px; background-color: #ffffff;\">\n  \n  <h1 style=\"color: #ff0050; font-size: 24px; margin-bottom: 10px; border-bottom: 2px solid #f3f4f6; padding-bottom: 10px;\">📊 TT-Insight 调研简报</h1>\n\n  <div style=\"margin-bottom: 24px;\">\n    <p style=\"margin: 8px 0;\"><span style=\"color: #6b7280; font-weight: 600;\">🎬 视频标题：</span>{{ $json.Title }}</p>\n    <p style=\"margin: 8px 0;\"><span style=\"color: #6b7280; font-weight: 600;\">🏷️ 视频标签：</span><span style=\"background-color: #f3f4f6; padding: 2px 8px; border-radius: 4px; font-size: 13px;\">{{ $json.Hashtags }}</span></p>\n <p style=\"margin: 8px 0;\"><span style=\"color: #6b7280; font-weight: 600;\">🏷️ 文化背景：</span><span style=\"background-color: #f3f4f6; padding: 2px 8px; border-radius: 4px; font-size: 13px;\">{{ $json.Cultural_Keyword }}</span></p>\n<p style=\"margin: 8px 0;\"><span style=\"color: #6b7280; font-weight: 600;\">📍 视频地址：</span><span style=\"background-color: #f3f4f6; padding: 2px 8px; border-radius: 4px; font-size: 13px;\">{{ $json.URL }}</span></p>\n  </div>\n\n  <div style=\"background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; margin-bottom: 24px;\">\n    <strong style=\"color: #111827; display: block; margin-bottom: 8px;\">🚀 市场爆发力评估</strong>\n    <span style=\"color: #374151;\">{{ $json.Market_Rating }}</span>\n  </div>\n\n  <div style=\"margin-bottom: 24px;\">\n    <h3 style=\"color: #111827; font-size: 18px; margin-bottom: 12px; display: flex; align-items: center;\">💡 核心深度洞察</h3>\n    \n    <div style=\"margin-bottom: 16px; padding-left: 12px; border-left: 3px solid #00f2ea;\">\n      <p style=\"font-weight: 600; margin: 0 0 4px 0;\">1. 钩子逻辑 (Hook Analysis)</p>\n      <p style=\"margin: 0; color: #4b5563;\">{{ $json.Hook_Analysis }}</p>\n    </div>\n\n    <div style=\"margin-bottom: 16px; padding-left: 12px; border-left: 3px solid #c425aa;\">\n      <p style=\"font-weight: 600; margin: 0 0 4px 0;\">2. 受众共鸣 (Audience Vibe)</p>\n      <p style=\"margin: 0; color: #4b5563;\">{{ $json.Audience_Vibe }}</p>\n    </div>\n\n    <div style=\"margin-bottom: 16px; padding-left: 12px; border-left: 3px solid #ff0050;\">\n      <p style=\"font-weight: 600; margin: 0 0 4px 0;\">3. 爆款方法论 (Methodology)</p>\n      <p style=\"margin: 0; color: #4b5563;\">{{ $json.Methodology }}</p>\n    </div>\n\n    <div style=\"margin-bottom: 16px; padding-left: 12px; border-left: 3px solid #ede621;\">\n      <p style=\"font-weight: 600; margin: 0 0 4px 0;\">4. 风险分析 (Risk Factor)</p>\n      <p style=\"margin: 0; color: #4b5563;\">{{ $json.Risk_Factor }}</p>\n    </div>\n  </div>\n\n  <div style=\"background-color: #111827; color: #f9fafb; border-radius: 12px; padding: 20px; margin-bottom: 24px;\">\n    <h4 style=\"margin: 0 0 10px 0; color: #00f2ea; font-size: 16px;\">🎤 运营价值分析 (Business Insight)</h4>\n    <p style=\"margin: 0; font-size: 14px; line-height: 1.7; font-style: italic;\">\"{{ $json.Business_Insight }}\"</p>\n  </div>\n\n  <div style=\"text-align: center; border-top: 1px solid #f3f4f6; padding-top: 16px; color: #9ca3af; font-size: 12px;\">\n    Generated by TT-Insight System v1.4 | {{ $now.toFormat('yyyy-MM-dd HH:mm') }}\n  </div>\n\n</div>"},"type":"n8n-nodes-base.form","typeVersion":2.5,"position":[688,-16],"id":"b9425c35-502d-4220-be34-da21601cade1","name":"Form","webhookId":"4be8dafa-21d9-4ca7-826f-c56120b0e03e"},{"parameters":{},"type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[-1152,-400],"id":"56fb0e8b-0b9e-4012-a6a5-c666968aefc9","name":"When clicking ‘Execute workflow’"},{"parameters":{"method":"POST","url":"https://api.apify.com/v2/acts/clockworks~tiktok-discover-scraper/run-sync-get-dataset-items?token=YOUR_APIFY_TOKEN","sendBody":true,"specifyBody":"json","jsonBody":"{\"hashtags\":[\"おすすめ\",\"バズった\",\"トレンド\",\"人気\"],\"resultsPerPage\":\"={{ $json.scrape_per_tag }}\"}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[-784,-400],"id":"a263fb32-9089-409a-ad48-1669e5034be0","name":"HTTP Request1"},{"parameters":{"options":{}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[-528,-320],"id":"61c46b54-b40c-4764-9888-4003cb4ca824","name":"Loop Over Items"},{"parameters":{"amount":3},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[288,-304],"id":"d87663af-2df0-479b-b63e-71fa42142ae1","name":"Wait","webhookId":"b8d321ca-0292-40a9-ac93-dce70f4b6336"},{"parameters":{"assignments":{"assignments":[{"id":"297e2925-5033-4674-8c31-3e7840b00f1e","name":"source_type","value":"Manual","type":"string"},{"id":"fb349405-441e-4700-886f-23d3c35d3651","name":"batch_id","value":"N/A","type":"string"},{"id":"url-field-manual","name":"url","value":"={{ $('On form submission').item.json['视频链接'] }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-544,0],"id":"ffd4578e-381f-4471-b473-dfc1c674a20d","name":"Edit Fields"},{"parameters":{"assignments":{"assignments":[{"id":"f21980ec-d6df-4793-88b2-98f94176c4e7","name":"source_type","value":"Weekly_Top20","type":"string"},{"id":"18e1d748-64d8-4c60-acee-30e6f8e9a14d","name":"batch_id","value":"={{ $now.toFormat('yyyy-WW') }}","type":"string"}]},"includeOtherFields":true,"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-272,-320],"id":"27905966-f476-4076-bffb-7e0b511f4e4e","name":"加Top标签"},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.Source }}","rightValue":"Manual","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"Manual"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.Source }}","rightValue":"Weekly_Top20","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"Weekly_Top20"}]},"options":{}},"type":"n8n-nodes-base.switch","typeVersion":3.2,"position":[432,0],"id":"a1b2c3d4-e5f6-7890-abcd-ef1234567890","name":"Route by Source"},{"parameters":{"aggregate":"aggregateAllItemData","options":{}},"type":"n8n-nodes-base.aggregate","typeVersion":1,"position":[-208,-464],"id":"269b8acd-6f23-4ca6-99b0-55e5ee4cb8b3","name":"Aggregate"},{"parameters":{"promptType":"define","text":"# Role\n你是一名深耕日本市场 10 年的 TikTok 资深运营专家，同时具备平台算法、流量分发与商业化的系统性视野。\n\n# Context\n当前日期：={{ $now.toFormat('yyyy-MM-dd') }}，本周为 ={{ $now.toFormat('yyyy年M月') + '第' + Math.ceil($now.day / 7) + '周' }}\n\n以下是本周 TikTok 日区 Top={{ $json.data.length }} 视频的逐条分析数据（JSON 数组）。\n每条包含：url、title、top_5_hashtags、stats、market_level_rating、hook_analysis、audience_vibe、cultural_keyword、content_format、distribution_signal、risk_factor、business_insight、copyable_methodology。\n\n输入数据：\n={{ $json.data.map(i => i.output) }}\n\n# Task\n基于以上 ={{ $json.data.length }} 条数据，输出一份结构化日本 TikTok 周报。\n严格按照下方 JSON 格式输出，禁止包含任何开场白或解释文字。\n\n# Analysis Rules\n\n1. [大盘健康度]\n   - 统计所有视频的播放量分布区间（<100万 / 100-500万 / >500万 各占比）\n   - 统计平均点赞率，判断本周日区整体情绪活跃度\n   - 结合 distribution_signal 字段，统计\"疑似官方助推\"和\"疑似付费推广\"占比\n   - 综合判断：本周日区流量是扩张、平稳还是收缩，生态是否健康\n\n2. [内容格局]\n   - 基于 content_format 字段统计各形式占比\n   - 基于内容主题将所有条目归类（あるある共感型 / 教育实用型 / 娱乐搞笑型 / 品牌营销型 / 社会议题型等）\n   - 找出本周最主导的内容形式和题材组合\n\n3. [爆款驱动逻辑]\n   - 聚焦点赞率 >3% 的视频\n   - 从 hook_analysis 提炼本周最有效的 Hook 结构（不超过3种）\n   - 从 audience_vibe 归纳触发高互动的情绪类型\n   - 判断爆款是靠\"内容质量驱动\"还是\"平台流量加持\"\n\n4. [文化热词图谱]\n   - 聚合所有 cultural_keyword，识别本周反复出现的社会情绪和文化符号\n   - 结合 risk_factor 字段，标注本周是否有潜在炎上风险的话题趋势\n\n5. [可复用内容方向]\n   - 从 copyable_methodology 字段提炼\n   - 输出 3 条本周可直接落地的内容创作建议\n   - 每条包含：方向名称 + 核心逻辑 + 一句话日文文案示例\n\n6. [广告生态识别]\n   - 汇总 distribution_signal 中付费/合作内容的特征\n   - 给出对有机创作者的启示：哪些赛道已被品牌占领，哪些仍是蓝海\n\n# Output（严格 JSON，禁止输出其他任何内容）\n{\n  \"weekly_title\": \"={{ $now.toFormat('yyyy年M月') + '第' + Math.ceil($now.day / 7) + '周' }} TikTok 日区内容洞察周报\",\n  \"data_period\": \"={{ $now.startOf('week').toFormat('yyyy-MM-dd') }} ~ ={{ $now.endOf('week').toFormat('yyyy-MM-dd') }}\",\n  \"analyzed_count\": ={{ $json.data.length }},  // 必须严格等于此数字，禁止自行估算\n\n  \"macro_health\": \"大盘健康度：播放量分布、平均点赞率、官方干预占比、整体生态判断（3-4句）\",\n\n  \"content_landscape\": \"内容格局：本周各内容形式占比、主导题材类型、最强势的形式+题材组合（3-4句）\",\n\n  \"viral_logic\": \"爆款驱动逻辑：本周最有效的Hook结构、高互动情绪类型、内容质量vs流量加持的比例判断（3-4句）\",\n\n  \"cultural_map\": \"文化热词图谱：本周核心文化符号、社会情绪趋势、潜在炎上风险提示（3-4句）\",\n\n  \"hot_hashtags\": [\"tag1\", \"tag2\", \"tag3\", \"tag4\", \"tag5\"],\n\n  \"actionable_ideas\": \"3条可落地内容方向，格式：【方向名】核心逻辑 + 日文文案示例\",\n\n  \"ad_ecosystem\": \"广告生态：付费内容特征总结、已被占领赛道 vs 蓝海机会（2-3句）\",\n\n  \"weekly_full_report\": \"以上所有板块的完整叙述版。约800字，中文写作，关键日文词汇保留原文并括注中文。适合直接阅读，逻辑清晰，有观点有数据，体现高阶运营视野。\"\n}","options":{}},"id":"b1c2d3e4-f5a6-7890-bcde-f12345678901","name":"周报 AI Agent","type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[48,-688]},{"parameters":{"options":{}},"id":"c2d3e4f5-a6b7-8901-cdef-123456789012","name":"DeepSeek 周报","type":"@n8n/n8n-nodes-langchain.lmChatDeepSeek","typeVersion":1,"position":[32,-272],"credentials":{"deepSeekApi":{"id":"3FWHrA6EDSqAyw9U","name":"DeepSeek account"}}},{"parameters":{"resource":"databasePage","databaseId":{"__rl":true,"value":"98f043d0-63f8-4304-9ce9-086a62ed9e47","mode":"list","cachedResultName":"TT Insight周报","cachedResultUrl":"https://www.notion.so/98f043d063f843049ce9086a62ed9e47"},"title":"={{ $json.weekly_title }}","propertiesUi":{"propertyValues":[{"key":"数据周期|rich_text","richText":true,"text":{"text":[{"text":"={{ $json.data_period }}","annotationUi":{}}]}},{"key":"大盘健康度|rich_text","richText":true,"text":{"text":[{"text":"={{ $json.macro_health }}","annotationUi":{}}]}},{"key":"内容格局|rich_text","richText":true,"text":{"text":[{"text":"={{ $json.content_landscape }}","annotationUi":{}}]}},{"key":"爆款逻辑|rich_text","richText":true,"text":{"text":[{"text":"={{ $json.viral_logic }}","annotationUi":{}}]}},{"key":"文化热词|rich_text","richText"