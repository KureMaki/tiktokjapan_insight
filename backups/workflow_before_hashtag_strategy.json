e":""},"conditions":[{"id":"check-min-count","leftValue":"={{ $json.data.length }}","rightValue":2,"operator":{"type":"number","operation":"gte"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[-64,-464],"id":"bd883707-c82e-4bdd-a868-65aff0dbf01c","name":"数据量检查"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":""},"conditions":[{"id":"check-source-manual","leftValue":"={{ (() => { try { return $('加Top标签').item.json.source_type } catch(e) { return $('Edit Fields').item.json.source_type } })() }}","rightValue":"Manual","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"id":"check-source-node-001","name":"检查来源","type":"n8n-nodes-base.if","typeVersion":2,"position":[-224,160]},{"parameters":{},"id":"error-form-node-001","name":"抓取失败提示","type":"n8n-nodes-base.form","typeVersion":3.2,"position":[240,352]},{"parameters":{"assignments":{"assignments":[{"id":"acd662c3-6b5b-4d22-81cb-5851044e5cf0","name":"target_count","value":10,"type":"number"},{"id":"a814ff99-de6a-4fef-b1f5-cabcbc33134b","name":"scrape_per_tag","value":4,"type":"number"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-960,-400],"id":"99c84f67-0425-4a1e-a0e9-9bcd6982b586","name":"周报参数"},{"parameters":{"jsCode":"// 将 webVideoUrl 映射为 url，保留所有原始字段\nconst items = $input.all();\nreturn items.map(item => ({\n  json: {\n    ...item.json,\n    url: item.json.webVideoUrl || item.json.url || item.json.videoUrl || ''\n  }\n}));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1136,-128],"id":"499c5318-73df-47f4-bb56-a245b1223758","name":"提取URL列表"},{"parameters":{"documentId":{"__rl":true,"value":"183Ncl8zN8doows4Zvy3IhVzo5iZ45uxgz4whX8IrBQo","mode":"id"},"sheetName":{"__rl":true,"value":"gid=0","mode":"list","cachedResultName":"工作表1","cachedResultUrl":"https://docs.google.com/spreadsheets/d/183Ncl8zN8doows4Zvy3IhVzo5iZ45uxgz4whX8IrBQo/edit#gid=0"},"options":{}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.5,"position":[-992,-128],"id":"15384203-aa70-4b2a-805f-f43e3bc403bb","name":"读取已有URL","credentials":{"googleSheetsOAuth2Api":{"id":"hdGavWk1HagzoUFs","name":"Google Sheets account"}}},{"parameters":{"jsCode":"// 过滤已在 Google Sheets 中存在的 URL，只保留新视频\nconst trendingItems = $('提取URL列表').all();\nconst existingRows = $('读取已有URL').all();\nconst targetCount = $('周报参数').first().json.target_count;\n\n// 构建已有 URL 集合\nconst existingUrls = new Set(\n  existingRows.map(r => r.json.URL).filter(Boolean)\n);\n\n// 过滤出新视频\nconst newItems = trendingItems.filter(item => !existingUrls.has(item.json.url));\n\n// 截取 target_count + 5 条作为缓冲（应对部分视频抓取失败）\nconst limit = Math.min(newItems.length, targetCount + 5);\n\nconsole.log(`去重结果: 热门视频${trendingItems.length}条，已有${existingUrls.size}条，新视频${newItems.length}条，本次处理${limit}条`);\n\nif (limit === 0) {\n  // 没有新视频，返回空数组让 loop 优雅结束\n  return [];\n}\n\nreturn newItems.slice(0, limit);"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-848,-128],"id":"f5e1d429-2be6-44b7-b15c-20ab75dbffa2","name":"去重过滤"}],"connections":{"HTTP Request":{"main":[[{"node":"跳过空数据","type":"main","index":0}]]},"DeepSeek Chat Model":{"ai_languageModel":[[{"node":"AI Agent","type":"ai_languageModel","index":0}]]},"AI Agent":{"main":[[{"node":"Append or update row in sheet","type":"main","index":0}]]},"Structured Output Parser":{"ai_outputParser":[[{"node":"AI Agent","type":"ai_outputParser","index":0}]]},"DeepSeek Chat Model1":{"ai_languageModel":[[{"node":"Structured Output Parser","type":"ai_languageModel","index":0}]]},"On form submission":{"main":[[{"node":"Edit Fields","type":"main","index":0}]]},"Append or update row in sheet":{"main":[[{"node":"Route by Source","type":"main","index":0}]]},"Route by Source":{"main":[[{"node":"Form","type":"main","index":0}],[{"node":"Wait","type":"main","index":0}]]},"When clicking ‘Execute workflow’":{"main":[[{"node":"周报参数","type":"main","index":0}]]},"HTTP Request1":{"main":[[{"node":"提取UR